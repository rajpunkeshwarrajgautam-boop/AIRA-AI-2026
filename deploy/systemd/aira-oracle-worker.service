# ==============================================================================
# AIRA AI 2026 — Oracle Cloud Always Free Systemd Service Unit
# Path: /etc/systemd/system/aira-oracle-worker.service
# Target: Ubuntu 22.04/24.04 LTS (aarch64) on VM.Standard.A1.Flex
# ==============================================================================

[Unit]
Description=AIRA Autonomous Specialist Worker (Oracle Cloud Always Free Ampere A1)
Documentation=https://github.com/rajpunkeshwarrajgautam-boop/AIRA-AI-2026
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=docker
WorkingDirectory=/opt/aira

# Environment variables from secure permissions-restricted path (chmod 600)
EnvironmentFile=/etc/aira/staging-worker.env

# Lifecycle Commands
ExecStartPre=-/usr/bin/docker compose -f /opt/aira/docker-compose.oracle-staging.yml down --remove-orphans
ExecStart=/usr/bin/docker compose -f /opt/aira/docker-compose.oracle-staging.yml up
ExecStop=/usr/bin/docker compose -f /opt/aira/docker-compose.oracle-staging.yml stop -t 30

# Restart Policies (Resilient against unexpected process exits)
Restart=always
RestartSec=10
TimeoutStopSec=35

# Systemd cgroup resource safeguards
CPUAccounting=true
MemoryAccounting=true
MemoryMax=2.5G
MemoryHigh=2.2G

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/aira
PrivateTmp=true

# Standardized logging to journald with tag
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aira-oracle-worker

[Install]
WantedBy=multi-user.target
