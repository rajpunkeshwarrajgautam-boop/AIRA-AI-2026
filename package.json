{
  "name": "aira-workspace-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:up": "docker-compose up -d db",
    "db:migrate": "npx tsx packages/db/src/scripts/migrate.ts",
    "dev": "vite",
    "server": "npx tsx apps/api/src/index.ts",
    "test": "npx tsx test/verify-runtime.ts",
    "test:integration": "npx tsx test/integration.ts",
    "test:e2e": "npx tsx test/e2e-verification.ts",
    "test:recovery": "npx tsx test/recovery.ts",
    "test:identity": "npx tsx test/identity.ts",
    "test:session-auth": "npx tsx test/session-auth.ts",
    "test:model-routing": "npx tsx test/model-router-provider-routing.ts",
    "test:router": "npx tsx test/intent-router.ts",
    "test:workflow": "npx tsx test/workflow-engine.ts",
    "test:startup": "npx tsx test/startup.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "memory:init": "npx @agentmemory/agentmemory@latest init",
    "memory:start": "npx @agentmemory/agentmemory@latest start --port 3113",
    "memory:ui": "npx @agentmemory/agentmemory@latest ui"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@phosphor-icons/react": "^2.1.10",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "knex": "^3.3.0",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
