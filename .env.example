# ==============================================================================
# AIRA AI Environment Configuration
# ==============================================================================

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Firebase Cloud Backend Configuration (Web App Client)
VITE_FIREBASE_API_KEY=AIzaSyDemoClaudeCloneKey00000000000000
VITE_FIREBASE_AUTH_DOMAIN=claude-clone-cloud.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=claude-clone-cloud
VITE_FIREBASE_STORAGE_BUCKET=claude-clone-cloud.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Firebase Local Emulator Host Override
# VITE_FIREBASE_EMULATOR=true

# Database Configuration (Postgres)
POSTGRES_USER=aira
POSTGRES_PASSWORD=aira
POSTGRES_DB=aira_db
DATABASE_URL=postgres://aira:aira@localhost:5432/aira_db

# Aira Bot local development identity (never enable for production)
# VITE_AIRA_DEV_IDENTITY=true

# Verify Firebase identity tokens on the API (same project as VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=

# Aira Bot routines run automatically in development/test-capable hosts.
# Production fails closed unless this is explicitly enabled.
AIRA_BOT_ROUTINES_ENABLED=false

# ==============================================================================
# Aira Bot Computer Runtime
# ==============================================================================
# local  = bounded host-process Playwright/execFile provider (development fallback)
# docker = one persistent isolated Docker computer per AIRA user, shared by that user's bots
AIRA_COMPUTER_PROVIDER=local

# Local provider: development/test defaults enabled unless explicitly false; production defaults disabled.
AIRA_COMPUTER_ENABLED=true
AIRA_COMPUTER_ROOT=.aira-computers

# Both providers use a direct allowlisted program runner; there is no free-form shell.
AIRA_COMPUTER_TERMINAL_ENABLED=false
AIRA_COMPUTER_PROGRAMS=node,npm,npx,python,python3,git

# Docker provider. Build once on the API/runtime host:
# docker build -t aira-computer:local docker/aira-computer
AIRA_COMPUTER_DOCKER_IMAGE=aira-computer:local
# Required in production when AIRA_COMPUTER_PROVIDER=docker. Use a long random server-side secret.
AIRA_COMPUTER_RUNNER_SECRET=
AIRA_COMPUTER_MEMORY=2g
AIRA_COMPUTER_CPUS=2
AIRA_COMPUTER_PIDS=256
