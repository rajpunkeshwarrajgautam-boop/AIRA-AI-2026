# ==============================================================================
# AIRA AI 2026 — Dedicated Specialist Worker Environment Configuration
# ==============================================================================
# Target Host: Oracle Ampere A1 Compute (Ubuntu 24.04 ARM64, 1 OCPU, ~6GB RAM)
# Target Service: aira-specialist-worker.service
# Target Location: /etc/aira/specialist-worker.env
#
# REQUIRED HOST PERMISSIONS & OWNERSHIP:
#   sudo chown root:aira /etc/aira/specialist-worker.env
#   sudo chmod 0600 /etc/aira/specialist-worker.env
#
# SECURITY DIRECTIVES:
# - NEVER commit real credentials or keys to source control.
# - DO NOT point this staging worker to production databases or production Neon branches.
# - The service strictly enforces non-root execution (User=aira, Group=aira).
# ==============================================================================

# Node Runtime Environment
NODE_ENV=production

# Dedicated Worker Mandatory Flags (all three must be 'true')
AIRA_SPECIALIST_WORKER_PROCESS=true
AIRA_SPECIALIST_WORKER_ENABLED=true
AIRA_SPECIALIST_DELEGATION_ENABLED=true

# Environment Guard (set to 'staging' to prevent accidental production collisions)
AIRA_ENVIRONMENT=staging
AIRA_STAGING=true

# Operational Health Probe Server Configuration
# Defaults to 127.0.0.1 for native systemd to prevent accidental public network exposure.
# Only queryable via local curl / Prometheus exporters on the Oracle host.
PORT=8080
HEALTH_PORT=8080
WORKER_HEALTH_HOST=127.0.0.1
# WORKER_HEALTH_ALLOW_EXTERNAL is NOT enabled for systemd host deployments

# Staging PostgreSQL Connection URL
# Must be a staging database with durable v2_delegations table and knex migrations applied.
# Format: postgresql://[user]:[password]@[host]:5432/[dbname]
# Example for local development / test database on host:
DATABASE_URL=postgres://aira:aira@127.0.0.1:5432/aira_db

# Cryptographic Mission Signing Key
# Minimum 32-character secret shared with staging API for HMAC signature verification.
AIRA_AGENT_PLAN_SIGNING_KEY=CHANGE_ME_STAGING_SIGNING_KEY_MIN_32_CHARS_LONG

# Approved Live Inference Provider Credentials
# At least one provider key is strictly required for specialist model mission execution.
# Populate only the approved staging provider credential:
NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
