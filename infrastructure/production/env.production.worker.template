# ==============================================================================
# AIRA AI 2026 — Production Specialist Worker Environment Configuration Template
# Path on Production Host: /etc/aira/production-worker.env
# Permissions: chmod 600 root:root (or chmod 640 root:docker)
# Classification: STRICTLY CONFIDENTIAL — PRODUCTION SECRETS TEMPLATE
#
# INVARIANTS:
# 1. AIRA_PRODUCTION_WORKER_ENABLED must be strictly "false" during Stage A (Standby)
#    and transitioned to "true" ONLY in Stage B after owner GO LIVE authorization.
# 2. EXPECTED_NEON_PROJECT_ID and EXPECTED_NEON_ENDPOINT_ID must strictly match
#    canonical production values. If DATABASE_URL points elsewhere, worker aborts.
# 3. Dedicated 32-byte hex AGENT_ENCRYPTION_KEY ensures cryptographic envelope isolation (AES-256-GCM).
# ==============================================================================

# Core Runtime Environment
NODE_ENV=production
AIRA_ENV=production

# Worker Activation Guard (Stage A: false | Stage B: true)
AIRA_PRODUCTION_WORKER_ENABLED=false

# Unique Production Worker Identity & Concurrency (Tuned for 1 OCPU / 6 GB VM)
WORKER_ID=worker_oracle_ampere_production_01
WORKER_CONCURRENCY=1
POLL_INTERVAL_MS=500
MAX_POLL_INTERVAL_MS=2000
IDLE_BACKOFF_MULTIPLIER=1.5
LEASE_DURATION_MS=15000
HEARTBEAT_INTERVAL_MS=3000

# Production Database Identity & Routing (Must route to Neon PgBouncer -pooler endpoint)
# This example intentionally omits password syntax. Inject the complete URL from the secret manager.
DATABASE_URL=postgresql://<PROD_USER>@ep-withered-art-b36ox90b-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
EXPECTED_NEON_PROJECT_ID=old-sky-50952395
EXPECTED_NEON_ENDPOINT_ID=ep-withered-art-b36ox90b

# Cryptographic Envelope Encryption Keys (32 bytes / 64 hex characters for AES-256-GCM)
# Generate via: openssl rand -hex 32
AGENT_ENCRYPTION_KEY=<PROD_32_BYTE_HEX_AES_256_GCM_ENVELOPE_KEY>
BROWSER_SESSION_ENCRYPTION_KEY=<PROD_32_BYTE_HEX_AES_256_GCM_BROWSER_KEY>

# Health & Readiness Server (Binds 127.0.0.1:8080 on host)
PORT=8080
WORKER_BIND_HOST=0.0.0.0
WORKER_PORT_BINDING=127.0.0.1:8080:8080

# Node.js V8 Heap Memory Quota (Bounded for 6 GB RAM Host)
NODE_OPTIONS=--max-old-space-size=1280

# Headless Chromium & Browser Automation
CHROMIUM_PATH=/usr/bin/chromium-browser
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Container Sandbox Isolation Architecture (Fail-Closed, Zero Docker Socket Mounts)
AIRA_REQUIRE_CONTAINER_SANDBOX=true
AIRA_ALLOW_LOCAL_SANDBOX=false
AIRA_SANDBOX_RUNNER_URL=http://sandbox-runner:8000
AIRA_SANDBOX_AUTH_TOKEN=<PROD_INTERNAL_SANDBOX_AUTH_TOKEN>

# AI Model Provider Production API Keys (Fail-Closed)
GROQ_API_KEY=<PROD_GROQ_API_KEY>
GEMINI_API_KEY=<PROD_GEMINI_API_KEY>
NVIDIA_API_KEY=<PROD_NVIDIA_API_KEY>
OPENAI_API_KEY=<PROD_OPENAI_API_KEY>
ANTHROPIC_API_KEY=<PROD_ANTHROPIC_API_KEY>

# Search & Tool Provider API Keys
TAVILY_API_KEY=<PROD_TAVILY_KEY>
EXA_API_KEY=<PROD_EXA_KEY>
GITHUB_TOKEN=<PROD_GITHUB_TOKEN>
